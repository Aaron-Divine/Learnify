# Learnify Environment Configuration

# Admin Account Configuration
ADMIN_EMAIL=admin@learnify.com
ADMIN_PASSWORD=learnify2026!

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Secret (for signed student session cookies)
SESSION_SECRET=learnify_session_secret_key_phase2_2026!

# ==========================================
# PHASE 2: WALLET PAYMENT PROVIDER
# ==========================================
# Options: "mock" (default for testing/dev) or "wallet" (real external wallet API)
PAYMENT_PROVIDER=mock

# Live Wallet API Configuration (used when PAYMENT_PROVIDER=wallet)
WALLET_API_URL=https://api.yourwallet.com/v1
WALLET_API_KEY=your_wallet_secret_key_here

# Cloud Storage & Database (Optional: if omitted, Learnify runs seamlessly with local persistent storage)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
